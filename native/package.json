{
  "name": "ancient-manager",
  "version": "2.6.0",
  "private": true,
  "description": "Ancient Manager — Dota 2 team management",
  "author": "Ancient Manager",
  "main": "desktop/main.cjs",
  "scripts": {
    "build:web": "node scripts/build-web.cjs",
    "start": "npm run build:web && electron .",
    "mac": "npm run build:web && electron-builder --mac --universal --publish never",
    "ios:sync": "npm run build:web && cap sync ios",
    "ios:open": "cap open ios",
    "test:desktop": "node tests/desktop.cjs"
  },
  "dependencies": {
    "@capacitor/core": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/share": "8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "electron": "44.9.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "playwright": "1.62.1"
  },
  "build": {
    "appId": "com.ancientmanager.game",
    "productName": "Ancient Manager",
    "directories": {
      "output": "out"
    },
    "files": [
      "desktop/**/*",
      "web/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.strategy-games",
      "icon": "../dist/assets/club-logos/0-square.png",
      "identity": "-",
      "hardenedRuntime": false,
      "notarize": false,
      "target": [
        "dmg",
        "zip"
      ]
    }
  }
}
